PORT=5000
NODE_ENV=development
RATE_LIMIT=200

# Database
DB_USER=postgres
DB_HOST=localhost
DB_NAME=ecommerce_db
DB_PASSWORD=postgres
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_db
PG_MAX_CLIENTS=20

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Elasticsearch
ES_NODE_URL=http://localhost:9200
ES_USER=elastic
ES_PASS=changeme
ES_PRODUCTS_INDEX=products

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
FROM_EMAIL=no-reply@example.com
COMPANY_NAME=My Store

# Auth
JWT_SECRET=changeme
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
APPLE_CLIENT_ID=your_apple_service_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=http://localhost:5000/api/v1/users/apple/callback

# Import Service
IMPORT_LOG_LEVEL=info
IMPORT_CONCURRENCY=4
IMPORT_BATCH_SIZE=100

# Brandsgateway (Shopwoo) API Configuration
BRANDSGATEWAY_API_URL=https://nova.shopwoo.com/api/v1
BRANDSGATEWAY_USERNAME=your_brandsgateway_email
BRANDSGATEWAY_PASSWORD=your_brandsgateway_password
BRANDSGATEWAY_STORE_ID=2

# BDroppy API 
BDROPPY_TOKEN=your_bdroppy_bearer_token
BDROPPY_USER_CATALOG=your_catalog_id_from_get_user_catalog
BDROPPY_BASE_URL=https://prod.bdroppy.com

# OpenAI (for AI category suggestions)
OPENAI_API_KEY=your_openai_api_key
